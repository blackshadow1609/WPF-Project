<UserControl x:Class="CustomTextboxControl.View.UserControls.ClearableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomTextboxControl.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="250"
             Focusable="True"
             IsTabStop="True">
    <Grid Background="Azure">
        <TextBox Name="txtInput" VerticalContentAlignment="Center"
                 Background="Transparent"
                 TextChanged="txtInput_TextChanged"
                 KeyDown="txtInput_KeyDown"
                 IsTabStop="True"
                 TabIndex="0"
                 Margin="5,0,30,0"/>
        <TextBlock Name="tbPlaceholder" Text="Placeholder"
                   FontSize="16" FontWeight="Light"
                   Foreground="DarkGray"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"
                   Panel.ZIndex="-1"
                   IsHitTestVisible="False"/>
        <Button Name="btnClear" Width="25" Height="25" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Margin="0,0,5,0"
                Content="X"
                Background="Transparent" 
                BorderThickness="0"
                IsTabStop="False"
                Cursor="Hand"
                FontWeight="Bold"
                Visibility="Visible">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse Fill="LightGray" Width="20" Height="20"/>
                                    <TextBlock Text="X" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               Foreground="White"
                                               FontWeight="Bold"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Ellipse Fill="Gray" Width="20" Height="20"/>
                                            <TextBlock Text="X" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"
                                                       Foreground="White"
                                                       FontWeight="Bold"/>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>